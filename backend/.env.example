# Flask Configuration
# Generate each Key with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
PORT=5000
DEBUG=false
SOCKETIO_LOGGER=false

# JWT Configuration (the server won't start without a Key)
JWT_SECRET_KEY=
JWT_EXPIRATION_HOURS=24

# Database Configuration
# SQLite (a local file) by default, or a Postgres URL (e.g. postgresql://user:password@localhost:5432/study_mates)
SQLALCHEMY_DATABASE_URI=sqlite:///study_mates.sqlite

# CORS Configuration (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
